generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  STAFF
  MEMBER
}

model User {
  id                 String       @id @default(cuid())
  discordId          String       @unique
  name               String
  avatar             String?
  createdAt          DateTime     @default(now())
  memberships        Membership[]
  createdCommunities Community[]  @relation("CreatedCommunities")
  applications ApplicationSubmission[]
}

model Community {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  logoUrl        String?
  weeklyShiftQuotaMinutes Int @default(120)
  shifts Shift[]
  createdAt      DateTime        @default(now())
  createdById    String
  createdBy      User            @relation("CreatedCommunities", fields: [createdById], references: [id])
  members        Membership[]
  moderationLogs ModerationLog[]
  applicationForms ApplicationForm[]
  erlcConnection ErlcConnection?
  erlcCommandLogs ErlcCommandLog[]
  staffRanks StaffRank[]
}

model Membership {
  id          String        @id @default(cuid())
  userId      String
  communityId String
  role        CommunityRole @default(MEMBER)
  staffTitle  String?
  rankId String?
  rank StaffRank? @relation(fields: [rankId], references: [id], onDelete: SetNull)
  suspendedUntil DateTime?
  suspensionReason String?
  leaveRequests LeaveRequest[]
  shifts Shift[]
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  community   Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model ModerationLog {
  id             String    @id @default(cuid())
  communityId    String
  actorId        String
  targetRobloxId String
  targetRobloxName String?
  action         String
  actorName      String?
  reason         String?
  createdAt      DateTime  @default(now())
  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
}

model LeaveRequest {
  id String @id @default(cuid())
  membershipId String
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate DateTime
  reason String
  status LeaveStatus @default(PENDING)
  reviewerNote String?
  createdAt DateTime @default(now())
  reviewedAt DateTime?

  @@index([membershipId, createdAt])
}

model Shift {
  id           String         @id @default(cuid())
  communityId  String
  membershipId String
  community    Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)
  membership   Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  startedAt    DateTime       @default(now())
  endedAt      DateTime?
  activities   ShiftActivity[]
  @@index([communityId, startedAt])
  @@index([membershipId, endedAt])
}

model ShiftActivity {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  category  String
  note      String
  createdAt DateTime @default(now())
  @@index([shiftId, createdAt])
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  ACCEPTED
  DENIED
}

model ApplicationForm {
  id          String                  @id @default(cuid())
  communityId String
  community   Community               @relation(fields: [communityId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isOpen      Boolean                 @default(false)
  questions   Json
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  submissions ApplicationSubmission[]

  @@index([communityId, createdAt])
}

model ApplicationSubmission {
  id           String            @id @default(cuid())
  formId       String
  form         ApplicationForm   @relation(fields: [formId], references: [id], onDelete: Cascade)
  applicantId  String
  applicant    User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  answers      Json
  questionSnapshot Json
  status       ApplicationStatus @default(PENDING)
  reviewerNote String?
  reviewerName String?
  submittedAt  DateTime          @default(now())
  reviewedAt   DateTime?

  @@unique([formId, applicantId])
  @@index([formId, submittedAt])
}

model ErlcConnection {
  id String @id @default(cuid())
  communityId String @unique
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  encryptedServerKey String
  serverName String
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ErlcCommandLog {
  id String @id @default(cuid())
  communityId String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actorId String
  actorName String
  actorRole String
  action String
  target String?
  command String
  status String @default("PENDING")
  response String?
  createdAt DateTime @default(now())
  completedAt DateTime?

  @@index([communityId, createdAt])
  @@index([actorId, createdAt])
}

model StaffRank {
 id String @id @default(cuid())
 communityId String
 community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
 name String
 color String @default("#6489ff")
 priority Int @default(0)
 permissions Json
 members Membership[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@unique([communityId,name])
 @@index([communityId,priority])
}
